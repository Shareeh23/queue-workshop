{
  "name": "queue-workshop",
  "version": "0.1.0",
  "private": true,
  "description": "A Node.js and TypeScript workshop for learning Redis, BullMQ, and background job processing.",
  "scripts": {
    "dev": "node --env-file=.env --import=tsx --watch ./src/server.ts",
    "dev:worker": "node --env-file=.env --import=tsx --watch ./src/workers/document.worker.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "node.js",
    "typescript",
    "redis",
    "bullmq",
    "message-queue",
    "background-jobs"
  ],
  "license": "ISC",
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "dependencies": {
    "bullmq": "^6.5.3",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
